// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "ui_font_family": ".ZedSans",
  "ui_font_size": 14,
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 14,
  "base_keymap": "JetBrains",
  "theme": {
    "mode": "system",
    "dark": "Catppuccin Mocha (Blur)",
    "light": "Catppuccin Latte (Blur)",
  },
  "icon_theme": {
    "mode": "system",
    "dark": "Catppuccin Mocha",
    "light": "Catppuccin Latte",
  },
  "soft_wrap": "editor_width",
  "project_panel": { "sticky_scroll": false },
  "snippet_sort_order": "top",
  "auto_install_extensions": {
    "astro": true,
    "catppuccin-blur": true, // Theme
    "catppuccin-icons": true, // Icon theme
    "codebook": true, // Spellcheck
    "csv": true,
    "docker-compose": true,
    "dockerfile": true,
    "emmet": true,
    "env": true,
    "fish": true,
    "git-firefly": true,
    "ini": true,
    "just": true,
    "latex": true,
    "make": true,
    "perplexity": true,
    "python-snippets": true,
    "ssh-config": true,
    "svelte": true,
    "terraform": true,
    "toml": true,
    "typst": true,
    "unocss": true,
  },
  "lsp": {
    "clangd": {
      "binary": {
        "path": "/opt/homebrew/opt/llvm/bin/clangd",
      },
    },
    "terraform-ls": {
      "initialization_options": {
        "experimentalFeatures": {
          "prefillRequiredFields": true,
        },
      },
    },
  },
  "languages": {
    "Python": {
      "language_servers": [
        // Disable basedpyright and enable Ty, and otherwise
        // use the default configuration.
        "ty",
        "!basedpyright",
        "...",
      ],
    },
  },
  "file_types": {
    "Dockerfile": ["Dockerfile.*"],
    "Git Attributes": ["**/{git,.git,.git/info}/attributes"],
    "Git Config": [
      "*.gitconfig",
      "**/{git,.git/modules,.git/modules/*}/config",
    ],
    "Git Ignore": ["**/{git,.git}/ignore", "**/.git/info/exclude"],
  },
  "terminal": {
    "env": {
      "GIT_EDITOR": "zed --wait",
    },
  },
  "calls": {
    "mute_on_join": true,
  },
  "auto_update": false, // Managed by Homebrew
}
